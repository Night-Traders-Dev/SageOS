#!/bin/sh
# sage-container — Universal launcher for SageOS Container
# Supports Bash, Fish, Zsh, and other POSIX-compatible shells.

# 1. Resolve Project Root (portable way to get absolute path)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR"

# 2. Define Internal Paths
SAGE_BIN="$PROJECT_ROOT/sageos_build/sage_lang/core/sage"
SAGE_LIB="$PROJECT_ROOT/sageos_build/sage_lang/core/lib"
LAUNCHER_SCRIPT="$PROJECT_ROOT/scripts/run_chroot.sage"

# 3. Validation
if [ ! -f "$SAGE_BIN" ]; then
    echo "Error: Sage interpreter not found at $SAGE_BIN"
    echo "Please build it first: cd sageos_build/sage_lang/core && make"
    exit 1
fi

if [ ! -f "$LAUNCHER_SCRIPT" ]; then
    echo "Error: Launcher script not found at $LAUNCHER_SCRIPT"
    exit 1
fi

# 4. Handle Architecture
ARCH="${1:-x64}"
if [ ! -d "$PROJECT_ROOT/SageRoot/$ARCH" ]; then
    echo "Error: RootFS for '$ARCH' not found in $PROJECT_ROOT/SageRoot/"
    echo "Available architectures: $(ls "$PROJECT_ROOT/SageRoot/" | tr '\n' ' ')"
    exit 1
fi

# 5. Launch with Elevated Privileges and Clean Environment
echo "Initializing SageOS Container ($ARCH)..."

# We pass SAGE_PATH explicitly to sudo to ensure the interpreter finds its stdlib
# even if the host shell environment isn't preserved.
sudo env SAGE_PATH="$SAGE_LIB" "$SAGE_BIN" "$LAUNCHER_SCRIPT" "$ARCH"
